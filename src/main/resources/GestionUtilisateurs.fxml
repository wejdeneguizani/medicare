<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="680.0" prefWidth="1100.0" spacing="12.0" style="-fx-background-color:#FFF4F8;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GestionUtilisateursController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox spacing="8.0">
            <children>
                <Button mnemonicParsing="false" onAction="#retourDashboard" styleClass="secondary-button" text="Retour" />
                <TextField fx:id="searchField" onAction="#rechercher" prefWidth="260.0" promptText="Rechercher nom, email, matricule" />
                <ComboBox fx:id="roleFilter" prefWidth="160.0" />
                <ComboBox fx:id="statutFilter" prefWidth="160.0" />
                <Button mnemonicParsing="false" onAction="#rechercher" styleClass="primary-button" text="Rechercher" />
                <Button mnemonicParsing="false" onAction="#ajouter" styleClass="success-button" text="Ajouter" />
            </children>
        </HBox>
        <TableView fx:id="tableUtilisateurs" prefHeight="560.0" styleClass="main-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMatricule" prefWidth="130.0" text="Matricule" />
                <TableColumn fx:id="colNomComplet" prefWidth="180.0" text="Nom complet" />
                <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
                <TableColumn fx:id="colRole" prefWidth="120.0" text="Role" />
                <TableColumn fx:id="colStatut" prefWidth="110.0" text="Statut" />
                <TableColumn fx:id="colConnexion" prefWidth="160.0" text="Derniere connexion" />
                <TableColumn fx:id="colActions" prefWidth="210.0" text="Actions" />
            </columns>
        </TableView>
        <Label fx:id="countLabel" text="0 utilisateur(s) affiche(s)" textFill="#8C6A78" />
    </children>
</VBox>
