<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="860.0"
            xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.GestionDisponibiliteController"
            style="-fx-background-color: #f0f4f8;">

    <Label text="📅 Disponibilités des Médecins"
           layoutX="30" layoutY="20"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a3c5e;"/>

    <Label text="Médecin ID:"       layoutX="30"  layoutY="75"/>
    <TextField fx:id="tfMedecinId"  layoutX="140" layoutY="71" prefWidth="100" promptText="ex: 5"/>

    <Label text="Date:"             layoutX="30"  layoutY="115"/>
    <TextField fx:id="tfDate"       layoutX="140" layoutY="111" prefWidth="130" promptText="2026-06-01"/>

    <Label text="Heure début:"      layoutX="30"  layoutY="155"/>
    <TextField fx:id="tfHeureDebut" layoutX="140" layoutY="151" prefWidth="100" promptText="08:00"/>

    <Label text="Heure fin:"        layoutX="30"  layoutY="195"/>
    <TextField fx:id="tfHeureFin"   layoutX="140" layoutY="191" prefWidth="100" promptText="12:00"/>

    <Label text="Statut:"           layoutX="30"  layoutY="235"/>
    <ComboBox fx:id="cbStatut"      layoutX="140" layoutY="231" prefWidth="160"/>

    <Button text="➕ Ajouter"    layoutX="30"  layoutY="280"
            onAction="#ajouterDispo"
            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
    <Button text="✏️ Modifier"   layoutX="130" layoutY="280"
            onAction="#modifierDispo"
            style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
    <Button text="🗑️ Supprimer"  layoutX="230" layoutY="280"
            onAction="#supprimerDispo"
            style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    <Button text="🔄 Actualiser" layoutX="330" layoutY="280"
            onAction="#chargerTous"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    <Button text="⬅️ Retour RDV" layoutX="450" layoutY="280"
            onAction="#retourRdv"
            style="-fx-background-color: #607D8B; -fx-text-fill: white;"/>

    <Label fx:id="lbMessage" layoutX="30" layoutY="320"
           style="-fx-text-fill: #e53935; -fx-font-weight: bold;"/>

    <TableView fx:id="tableDispo" layoutX="30" layoutY="345"
               prefWidth="800" prefHeight="220">
        <columns>
            <TableColumn fx:id="colId"      text="ID"        prefWidth="40"/>
            <TableColumn fx:id="colMedecin" text="Médecin"   prefWidth="80"/>
            <TableColumn fx:id="colDate"    text="Date"      prefWidth="110"/>
            <TableColumn fx:id="colDebut"   text="Début"     prefWidth="80"/>
            <TableColumn fx:id="colFin"     text="Fin"       prefWidth="80"/>
            <TableColumn fx:id="colStatut"  text="Statut"    prefWidth="120"/>
        </columns>
    </TableView>

</AnchorPane>