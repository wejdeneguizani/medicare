<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="1100.0" style="-fx-background-color:#FFF4F8;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PatientDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="18.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>
                <Label text="Medicare+" textFill="#A64D79">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#ouvrirProfil" styleClass="primary-button" text="Profil" />
                <Button mnemonicParsing="false" onAction="#deconnexion" styleClass="secondary-button" text="Deconnexion" />
            </children>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="220.0" spacing="8.0" styleClass="side-panel">
            <padding>
                <Insets bottom="20.0" left="18.0" right="18.0" top="20.0" />
            </padding>
            <children>
                <Label text="Navigation patient" textFill="#8C6A78" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button-active" text="Tableau de bord" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirHistorique" styleClass="sidebar-button" text="Historique" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox maxWidth="920.0" spacing="22.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="6.0">
                    <children>
                        <Label fx:id="welcomeLabel" text="Bonjour" textFill="#A64D79">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                        <Label text="Votre espace patient regroupe vos traitements, assurances, routines, objectifs et rendez-vous." textFill="#8C6A78" wrapText="true">
                            <font>
                                <Font size="15.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <GridPane hgap="16.0" vgap="16.0">
                    <children>
                        <VBox prefHeight="220.0" prefWidth="290.0" spacing="14.0" styleClass="dashboard-card">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label styleClass="card-symbol" text="Rx" />
                                <Label text="Medicaments" textFill="#A64D79">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                                <Label text="Consultez les heures de prise et gardez vos traitements organises." textFill="#8C6A78" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirMedicaments" styleClass="primary-button" text="Voir mes prises" />
                            </children>
                        </VBox>
                        <VBox prefHeight="220.0" prefWidth="290.0" spacing="14.0" styleClass="dashboard-card" GridPane.columnIndex="1">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label styleClass="card-symbol progress-symbol" text="OBJ" />
                                <Label text="Objectifs et coaching" textFill="#A64D79">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Label text="Fixez vos objectifs de sante et recevez des conseils pour rester regulier." textFill="#8C6A78" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirProgression" styleClass="success-button" text="Voir mes objectifs" />
                            </children>
                        </VBox>
                        <VBox prefHeight="220.0" prefWidth="290.0" spacing="14.0" styleClass="dashboard-card" GridPane.columnIndex="2">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label styleClass="card-symbol appointment-symbol" text="RDV" />
                                <Label text="Rendez-vous" textFill="#A64D79">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                                <Label text="Demandez un rendez-vous avec un medecin et suivez vos demandes." textFill="#8C6A78" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirRendezVous" styleClass="primary-button" text="Prendre rendez-vous" />
                            </children>
                        </VBox>
                        <VBox prefHeight="220.0" prefWidth="290.0" spacing="14.0" styleClass="dashboard-card" GridPane.rowIndex="1">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label styleClass="card-symbol insurance-symbol" text="ASS" />
                                <Label text="Assurances" textFill="#A64D79">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                                <Label text="Consultez vos garanties, vos documents et vos prises en charge." textFill="#8C6A78" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirAssurances" styleClass="primary-button" text="Voir mes assurances" />
                            </children>
                        </VBox>
                        <VBox prefHeight="220.0" prefWidth="290.0" spacing="14.0" styleClass="dashboard-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label styleClass="card-symbol routine-symbol" text="DAY" />
                                <Label text="Routines quotidiennes" textFill="#A64D79">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Label text="Organisez vos habitudes de sante, rappels et actions de chaque jour." textFill="#8C6A78" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirRoutines" styleClass="success-button" text="Voir mes routines" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>
                <HBox spacing="14.0">
                    <children>
                        <VBox prefWidth="450.0" spacing="8.0" styleClass="summary-panel">
                            <children>
                                <Label text="Prochaine prise" textFill="#8C6A78" />
                                <Label text="Aucun medicament programme" textFill="#A64D79">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox prefWidth="450.0" spacing="8.0" styleClass="summary-panel">
                            <children>
                                <Label text="Prochain rendez-vous" textFill="#8C6A78" />
                                <Label text="Aucune demande en cours" textFill="#A64D79">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
