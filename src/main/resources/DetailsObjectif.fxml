<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DetailsObjectifController"
            style="-fx-background-color: #FDF6F9; -fx-padding: 30;">

    <Label text="Détails de l'Objectif" layoutX="0" layoutY="0"
           style="-fx-text-fill: #D4728E; -fx-font-size: 22px; -fx-font-weight: bold;" />

    <Button text="← Retour aux objectifs" layoutX="0" layoutY="40"
            onAction="#retourListe"
            style="-fx-background-color: #FCE8EF; -fx-text-fill: #D4728E; -fx-border-color: #D4728E; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 16 6 16; -fx-cursor: hand;" />

    <VBox layoutX="0" layoutY="90" prefWidth="700" prefHeight="340" spacing="18"
          style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 25;">
        <HBox spacing="20">
            <Label text="Titre :"          prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbTitre"                         style="-fx-text-fill: #222222; -fx-font-weight: bold;" />
        </HBox>
        <HBox spacing="20">
            <Label text="Catégorie :"      prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbCategorie"                     style="-fx-text-fill: #222222;" />
        </HBox>
        <HBox spacing="20">
            <Label text="Valeur cible :"   prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbValeurCible"                   style="-fx-text-fill: #222222;" />
        </HBox>
        <HBox spacing="20">
            <Label text="Unité :"          prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbUniteMesure"                   style="-fx-text-fill: #222222;" />
        </HBox>
        <HBox spacing="20">
            <Label text="Date début :"     prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbDateDebut"                     style="-fx-text-fill: #222222;" />
        </HBox>
        <HBox spacing="20">
            <Label text="Date échéance :"  prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbDateEcheance"                  style="-fx-text-fill: #222222;" />
        </HBox>
        <HBox spacing="20">
            <Label text="Statut :"         prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbStatut"
                   style="-fx-background-color: #FCE8EF; -fx-text-fill: #D4728E; -fx-background-radius: 12; -fx-padding: 2 10 2 10;" />
        </HBox>
        <HBox spacing="20">
            <Label text="Priorité :"       prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbPriorite"                      style="-fx-text-fill: #222222;" />
        </HBox>
        <HBox spacing="20">
            <Label text="ID Patient :"     prefWidth="150" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbIdPatient"                     style="-fx-text-fill: #222222;" />
            <Label text="ID Médecin :"     prefWidth="110" style="-fx-text-fill: #999999;" />
            <Label fx:id="lbIdMedecin"                     style="-fx-text-fill: #222222;" />
        </HBox>
    </VBox>

</AnchorPane>