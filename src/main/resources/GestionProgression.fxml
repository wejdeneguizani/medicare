<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.GestionProgressionController"
            style="-fx-background-color: #FDF6F9;">

    <Label text="Gestion des Progressions" layoutX="30" layoutY="20"
           style="-fx-text-fill: #D4728E; -fx-font-size: 22px; -fx-font-weight: bold;" />
    <Label text="Suivez l'évolution des objectifs par patient" layoutX="30" layoutY="50"
           style="-fx-text-fill: #999999; -fx-font-size: 12px;" />

    <Label text="ID Objectif" layoutX="30" layoutY="90" style="-fx-text-fill: #555555;" />
    <TextField fx:id="tfIdObjectif" layoutX="140" layoutY="85" prefWidth="130" promptText="ID objectif"
               style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #222222; -fx-prompt-text-fill: #999999;" />

    <Label text="Date mesure" layoutX="290" layoutY="90" style="-fx-text-fill: #555555;" />
    <DatePicker fx:id="dpDateMesure" layoutX="390" layoutY="85" prefWidth="165"
                style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6;" />

    <Label text="Valeur actuelle" layoutX="30" layoutY="135" style="-fx-text-fill: #555555;" />
    <TextField fx:id="tfValeurActuelle" layoutX="140" layoutY="130" prefWidth="130" promptText="Ex: 68.5"
               style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #222222;" />

    <Label text="Valeur cible" layoutX="290" layoutY="135" style="-fx-text-fill: #555555;" />
    <TextField fx:id="tfValeurCible" layoutX="390" layoutY="130" prefWidth="130" promptText="Ex: 65.0"
               style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #222222;" />

    <Label text="Humeur" layoutX="30" layoutY="180" style="-fx-text-fill: #555555;" />
    <ComboBox fx:id="cbHumeur" layoutX="140" layoutY="175" prefWidth="180"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6;" />

    <Label text="Notes" layoutX="340" layoutY="180" style="-fx-text-fill: #555555;" />
    <TextField fx:id="tfNotes" layoutX="400" layoutY="175" prefWidth="300" promptText="Remarques..."
               style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #222222; -fx-prompt-text-fill: #999999;" />

    <Button text="+ Ajouter" layoutX="30" layoutY="225" onAction="#ajouterProgression"
            style="-fx-background-color: #D4728E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 7 18 7 18; -fx-cursor: hand;" />
    <Button text="Modifier" layoutX="140" layoutY="225" onAction="#modifierProgression"
            style="-fx-background-color: #FCE8EF; -fx-text-fill: #D4728E; -fx-border-color: #D4728E; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 18 7 18; -fx-cursor: hand;" />
    <Button text="Supprimer" layoutX="240" layoutY="225" onAction="#supprimerProgression"
            style="-fx-background-color: #FCE8EF; -fx-text-fill: #D4728E; -fx-border-color: #D4728E; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 18 7 18; -fx-cursor: hand;" />
    <Button text="Vider" layoutX="355" layoutY="225" onAction="#viderFormulaire"
            style="-fx-background-color: #F5F0F2; -fx-text-fill: #555555; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 18 7 18; -fx-cursor: hand;" />
    <Button text="Voir Détails" layoutX="430" layoutY="225" onAction="#voirDetails"
            style="-fx-background-color: #F5F0F2; -fx-text-fill: #555555; -fx-border-color: #E0CDD4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 18 7 18; -fx-cursor: hand;" />

    <Label fx:id="lbMessage" layoutX="30" layoutY="265"
           style="-fx-text-fill: #D4728E; -fx-font-style: italic;" />

    <Label text="Mes progressions  (cliquer pour sélectionner)" layoutX="30" layoutY="286"
           style="-fx-text-fill: #999999; -fx-font-size: 12px;" />

    <TableView fx:id="tableView" layoutX="30" layoutY="309" prefWidth="940" prefHeight="365"
               style="-fx-background-color: #FFFFFF; -fx-border-color: #E0CDD4; -fx-border-radius: 8; -fx-background-radius: 8;">
        <columns>
            <TableColumn fx:id="colId"            text="ID"             prefWidth="60"  />
            <TableColumn fx:id="colIdObjectif"    text="ID Objectif"    prefWidth="120" />
            <TableColumn fx:id="colDateMesure"    text="Date mesure"    prefWidth="150" />
            <TableColumn fx:id="colValeurActuelle" text="Val. actuelle" prefWidth="130" />
            <TableColumn fx:id="colValeurCible"   text="Val. cible"     prefWidth="120" />
            <TableColumn fx:id="colHumeur"        text="Humeur"         prefWidth="200" />
        </columns>
    </TableView>

</AnchorPane>