<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" styleClass="doctor-root" stylesheets="@../styles/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.medicare.controllers.DoctorDashboardController">
    
    <!-- Navbar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" styleClass="doctor-navbar">
            <Label text="🩺 MediCare Doctor" styleClass="doctor-brand" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="20.0">
                <TextField fx:id="searchField" promptText="Search by title, type, date, values..." styleClass="doctor-search" onKeyReleased="#handleSearchChanged" />
                <Button text="Logout" onAction="#handleLogout" styleClass="pill-button-primary" />
            </HBox>
        </HBox>
    </top>

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="280.0" spacing="15.0" styleClass="doctor-sidebar">
            <Label text="MANAGEMENT" styleClass="sidebar-title" />
            
            <Button fx:id="btnOverview" text="🌸 Overview" maxWidth="Infinity" onAction="#handleOverview" styleClass="nav-btn-active" />
            
            <Button fx:id="btnHabitudes" text="📋 Patient Habits" maxWidth="Infinity" onAction="#showHabits" styleClass="nav-btn" />
            
            <Button fx:id="btnMesures" text="📏 Measurements" maxWidth="Infinity" onAction="#showMesures" styleClass="nav-btn" />
            
            <Button text="👥 Patients List" maxWidth="Infinity" styleClass="nav-btn" />
            
            <Separator styleClass="soft-separator" />
            <Label text="SYSTEM" styleClass="sidebar-title" />
            <Button text="⚙️ Settings" maxWidth="Infinity" styleClass="nav-btn" />
        </VBox>
    </left>

    <!-- Content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
            <VBox spacing="40.0" styleClass="dashboard-content">
                <VBox spacing="8.0">
                    <Label fx:id="contentTitle" text="Global Health Monitoring" styleClass="dashboard-title" />
                    <Label fx:id="contentSubtitle" text="Manage and monitor all patient activities effortlessly" styleClass="dashboard-subtitle" />
                </VBox>

                <HBox fx:id="filtersBox" alignment="CENTER_LEFT" spacing="12.0" styleClass="filters-panel">
                    <Label text="Patient" styleClass="filter-label" />
                    <ComboBox fx:id="patientFilterCombo" promptText="All" onAction="#handleFilterChanged" styleClass="filter-combo" />
                    <Label text="Habit Type" styleClass="filter-label" />
                    <ComboBox fx:id="typeFilterCombo" promptText="All" onAction="#handleFilterChanged" styleClass="filter-combo" />
                    <Label text="Habit Status" styleClass="filter-label" />
                    <ComboBox fx:id="statusFilterCombo" promptText="All" onAction="#handleFilterChanged" styleClass="filter-combo" />
                    <Button text="Reset Filters" styleClass="btn-filter-reset" onAction="#handleResetFilters" />
                    <Button text="Refresh Stats" styleClass="btn-stats-refresh" onAction="#handleRefreshStats" />
                </HBox>

                <StackPane alignment="TOP_LEFT">
                    <!-- Overview Section (Default) -->
                    <VBox fx:id="overviewSection" spacing="30.0">
                         <Label text="Welcome back, Dr.!" styleClass="welcome-label" />
                         <HBox spacing="20.0" styleClass="stats-cards-container">
                             <VBox spacing="10.0" styleClass="stat-card">
                                 <Label text="Total Patients" styleClass="stat-label" />
                                 <Label fx:id="totalPatientsValue" text="0" styleClass="stat-value" />
                             </VBox>
                             <VBox spacing="10.0" styleClass="stat-card">
                                 <Label text="Total Habits" styleClass="stat-label" />
                                 <Label fx:id="totalHabitsValue" text="0" styleClass="stat-value" />
                             </VBox>
                             <VBox spacing="10.0" styleClass="stat-card">
                                 <Label text="Total Measurements" styleClass="stat-label" />
                                 <Label fx:id="totalMesuresValue" text="0" styleClass="stat-value" />
                             </VBox>
                             <VBox spacing="10.0" styleClass="stat-card">
                                 <Label text="Avg Steps" styleClass="stat-label" />
                                 <Label fx:id="avgStepsValue" text="0" styleClass="stat-value" />
                             </VBox>
                         </HBox>
                        <HBox spacing="20.0" styleClass="charts-container">
                            <VBox spacing="8.0" styleClass="chart-card">
                                <PieChart fx:id="habitsByTypeChart" title="Habits By Type" prefWidth="360.0" prefHeight="280.0" />
                            </VBox>
                            <VBox spacing="8.0" styleClass="chart-card">
                                <BarChart fx:id="stepsByPatientChart" title="Total Steps By Patient" prefWidth="420.0" prefHeight="280.0">
                                    <xAxis>
                                        <CategoryAxis label="Patient" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Steps" />
                                    </yAxis>
                                </BarChart>
                            </VBox>
                            <VBox spacing="8.0" styleClass="chart-card">
                                <LineChart fx:id="waterTrendChart" title="Water Intake Trend" prefWidth="420.0" prefHeight="280.0">
                                    <xAxis>
                                        <CategoryAxis label="Date" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Liters" />
                                    </yAxis>
                                </LineChart>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Habits Section -->
                    <VBox fx:id="habitsSection" spacing="25.0" visible="false" StackPane.alignment="TOP_LEFT">
                        <ScrollPane fitToWidth="true" prefHeight="560.0" styleClass="section-scroll">
                            <content>
                                <FlowPane fx:id="habitudesContainer" hgap="30.0" vgap="30.0" />
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- Measurements Section -->
                    <VBox fx:id="mesuresSection" spacing="25.0" visible="false" StackPane.alignment="TOP_LEFT">
                        <ScrollPane fitToWidth="true" prefHeight="560.0" styleClass="section-scroll">
                            <content>
                                <FlowPane fx:id="mesuresContainer" hgap="30.0" vgap="30.0" />
                            </content>
                        </ScrollPane>
                    </VBox>
                </StackPane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
