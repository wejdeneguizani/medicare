<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="700.0" prefWidth="1050.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medical.controllers.StockController"
            stylesheets="@style.css">

    <children>
        <VBox spacing="15" layoutX="20" layoutY="20" prefWidth="1010">

            <!-- HEADER -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color: #fce4ec;
                   -fx-padding: 15px;
                   -fx-background-radius: 12px;">
                <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="@logo.png"/>
                    </image>
                </ImageView>
                <VBox spacing="4">
                    <Label text="Medicare+"
                           style="-fx-font-size: 28px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #e91e8c;"/>
                    <Label text="Votre santé, notre priorité"
                           style="-fx-font-size: 12px;
                        -fx-text-fill: #f48fb1;
                        -fx-font-style: italic;"/>
                </VBox>
            </HBox>

            <HBox spacing="8" alignment="CENTER"
                  style="-fx-background-color: #f9c4d8; -fx-padding: 10px; -fx-background-radius: 10px;">
                <Button text=" Médicaments" onAction="#allerMedicaments"
                        style="-fx-background-color: #f9c4d8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 15px;"/>
                <Button text="Catégories" onAction="#allerCategories"
                        style="-fx-background-color: #f9c4d8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 15px;"/>
                <Button text=" Fabricants" onAction="#allerFabricants"
                        style="-fx-background-color: #f9c4d8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 15px;"/>
                <Button text=" Formes" onAction="#allerFormes"
                        style="-fx-background-color: #f9c4d8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 15px;"/>
                <Button text=" Stock" onAction="#allerStock"
                        style="-fx-background-color: #f48fb1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 15px;"/>
                <Button text=" Alertes" onAction="#allerAlertes"
                        style="-fx-background-color: #f9c4d8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 15px;"/>
                <Button text=" Chatbot" onAction="#allerChatbot"
                        style="-fx-background-color: #f9c4d8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8px 15px;"/>
            </HBox>

            <!-- TITRE -->
            <Label text="Gestion du Stock" styleClass="titre"/>

            <!-- FORMULAIRE - 2 colonnes -->
            <HBox spacing="30">
                <VBox spacing="10">
                    <HBox spacing="10">
                        <Label text="ID Médicament :" style="-fx-pref-width: 150"/>
                        <TextField fx:id="tfIdMedicament" promptText="ex: 1" prefWidth="180"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Numéro de lot :" style="-fx-pref-width: 150"/>
                        <TextField fx:id="tfNumeroLot" promptText="ex: LOT-2024-001" prefWidth="180"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Quantité :" style="-fx-pref-width: 150"/>
                        <TextField fx:id="tfQuantite" promptText="ex: 100" prefWidth="180"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Seuil d'alerte :" style="-fx-pref-width: 150"/>
                        <TextField fx:id="tfSeuilAlerte" promptText="ex: 10" prefWidth="180"/>
                    </HBox>
                </VBox>
                <VBox spacing="10">
                    <HBox spacing="10">
                        <Label text="Prix unitaire (DT) :" style="-fx-pref-width: 160"/>
                        <TextField fx:id="tfPrixUnitaire" promptText="ex: 2.50" prefWidth="180"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Date expiration :" style="-fx-pref-width: 160"/>
                        <TextField fx:id="tfDateExpiration" promptText="yyyy-MM-dd" prefWidth="180"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Localisation :" style="-fx-pref-width: 160"/>
                        <TextField fx:id="tfLocalisation" promptText="ex: Armoire A" prefWidth="180"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Fournisseur :" style="-fx-pref-width: 160"/>
                        <TextField fx:id="tfFournisseur" promptText="Nom du fournisseur" prefWidth="180"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- BOUTONS -->
            <HBox spacing="10">
                <Button text=" Ajouter au stock" onAction="#ajouterStock"/>
                <Button text="Supprimer" onAction="#supprimerStock"
                        styleClass="button-supprimer"/>
                <Button text=" Stock faible" onAction="#afficherStockFaible"
                        style="-fx-background-color: #ff9800;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8px;
                               -fx-padding: 8px 20px;"/>
                <Button text=" Tout afficher" onAction="#afficherTout"
                        style="-fx-background-color: #9c27b0;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8px;
                               -fx-padding: 8px 20px;"/>
            </HBox>

            <!-- MESSAGE -->
            <Label fx:id="lbMessage"/>

            <!-- TABLE -->
            <TableView fx:id="tableView" prefHeight="260" prefWidth="1010">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colIdMed" text="ID Méd." prefWidth="70"/>
                    <TableColumn fx:id="colLot" text="N° Lot" prefWidth="130"/>
                    <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="80"/>
                    <TableColumn fx:id="colSeuil" text="Seuil" prefWidth="70"/>
                    <TableColumn fx:id="colPrix" text="Prix (DT)" prefWidth="90"/>
                    <TableColumn fx:id="colExpiration" text="Expiration" prefWidth="110"/>
                    <TableColumn fx:id="colLocalisation" text="Localisation" prefWidth="110"/>
                    <TableColumn fx:id="colFournisseur" text="Fournisseur" prefWidth="130"/>
                </columns>
            </TableView>

        </VBox>
    </children>
</AnchorPane>
