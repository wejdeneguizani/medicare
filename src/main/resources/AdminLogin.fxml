<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="1100.0" style="-fx-background-color:#FFF4F8;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminLoginController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="18.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>
                <Label text="Medicare+" textFill="#A64D79">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#retourAccueil" styleClass="secondary-button" text="Retour" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" maxWidth="460.0" spacing="18.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Admin Login" textFill="#A64D79">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>
                <Label text="Entrez les identifiants administrateur pour acceder au dashboard." textFill="#8C6A78" wrapText="true">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <GridPane hgap="12.0" maxWidth="460.0" styleClass="form-panel" vgap="12.0">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <children>
                        <Label text="Email admin *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="emailField" promptText="hayder@gmail.com" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label text="Mot de passe admin *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <PasswordField fx:id="motDePasseField" promptText="123456" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
                <Label text="ou" textFill="#8C6A78">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Button maxWidth="460.0" mnemonicParsing="false" onAction="#seConnecterAvecGoogle" styleClass="secondary-button" text="Continuer avec Google" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#seConnecterAdmin" styleClass="primary-button" text="Se connecter" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
