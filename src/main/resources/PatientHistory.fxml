<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="1100.0" style="-fx-background-color:#FFF4F8;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PatientHistoryController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="16.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>
                <Label text="Medicare+" textFill="#A64D79">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#retourDashboard" styleClass="secondary-button" text="Retour tableau de bord" />
            </children>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="220.0" spacing="8.0" styleClass="side-panel">
            <padding>
                <Insets bottom="20.0" left="18.0" right="18.0" top="20.0" />
            </padding>
            <children>
                <Label text="Navigation patient" textFill="#8C6A78" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#retourDashboard" styleClass="sidebar-button" text="Tableau de bord" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button-active" text="Historique" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox maxWidth="820.0" spacing="14.0" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="titleLabel" text="Historique recent" textFill="#A64D79">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label text="Retrouvez vos derniers rendez-vous, prises de medicaments et activites importantes." textFill="#8C6A78" wrapText="true" />
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="history-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="historiqueContainer" spacing="10.0" styleClass="history-container">
                            <padding>
                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
