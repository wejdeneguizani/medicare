<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="1100.0" style="-fx-background-color:#FFF4F8;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="18.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>
                <Label text="Medicare+" textFill="#A64D79">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#ouvrirAdmin" styleClass="secondary-button" text="Admin Login" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" maxWidth="620.0" spacing="18.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Bienvenue sur Medicare+" textFill="#A64D79">
                    <font>
                        <Font name="System Bold" size="34.0" />
                    </font>
                </Label>
                <Label text="Connectez-vous ou creez un compte pour acceder a votre espace." textFill="#8C6A78" wrapText="true">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#ouvrirLogin" prefWidth="180.0" styleClass="primary-button" text="Se connecter" />
                        <Button mnemonicParsing="false" onAction="#ouvrirCreationCompte" prefWidth="180.0" styleClass="success-button" text="Creer un compte" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
