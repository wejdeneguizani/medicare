<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/22.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medical.controller.MedicamentController">
    <children>

        <!-- TITRE -->
        <Label text="Gestion des Médicaments"
               layoutX="320" layoutY="20"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- FORMULAIRE GAUCHE -->
        <Label text="Nom Commercial :" layoutX="30" layoutY="80"/>
        <Label text="Nom DCI :"        layoutX="30" layoutY="120"/>
        <Label text="Code Barre :"     layoutX="30" layoutY="160"/>
        <Label text="Dosage :"         layoutX="30" layoutY="200"/>
        <Label text="Unité Dosage :"   layoutX="30" layoutY="240"/>

        <TextField fx:id="tfNomCommercial" layoutX="160" layoutY="75"  prefWidth="180"/>
        <TextField fx:id="tfNomDci"        layoutX="160" layoutY="115" prefWidth="180"/>
        <TextField fx:id="tfCodeBarre"     layoutX="160" layoutY="155" prefWidth="180"/>
        <TextField fx:id="tfDosage"        layoutX="160" layoutY="195" prefWidth="180"/>
        <TextField fx:id="tfUniteDosage"   layoutX="160" layoutY="235" prefWidth="180"/>

        <!-- FORMULAIRE DROITE -->
        <Label text="Description :"       layoutX="380" layoutY="80"/>
        <Label text="Contre-indications:" layoutX="380" layoutY="160"/>
        <Label text="Effets secondaires:" layoutX="380" layoutY="240"/>

        <TextField fx:id="tfDescription"       layoutX="530" layoutY="75"  prefWidth="180"/>
        <TextField fx:id="tfContreIndications" layoutX="530" layoutY="155" prefWidth="180"/>
        <TextField fx:id="tfEffetsSecondaires" layoutX="530" layoutY="235" prefWidth="180"/>

        <!-- CHECKBOX -->
        <CheckBox fx:id="cbEstActif" text="Actif" layoutX="160" layoutY="280"/>

        <!-- BOUTONS -->
        <Button text="➕ Ajouter"    layoutX="50"  layoutY="330" onAction="#ajouterMedicament"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-pref-width: 100;"/>
        <Button text="✏️ Modifier"   layoutX="170" layoutY="330" onAction="#modifierMedicament"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-pref-width: 100;"/>
        <Button text="🗑️ Supprimer"  layoutX="290" layoutY="330" onAction="#supprimerMedicament"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-pref-width: 100;"/>
        <Button text="🔄 Actualiser" layoutX="410" layoutY="330" onAction="#afficherMedicaments"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-pref-width: 100;"/>

        <!-- TABLEAU -->
        <TableView fx:id="tableMedicament" layoutX="30" layoutY="380"
                   prefWidth="890" prefHeight="240">
            <columns>
                <TableColumn fx:id="colId"                text="ID"                prefWidth="50"/>
                <TableColumn fx:id="colNomCommercial"     text="Nom Commercial"    prefWidth="130"/>
                <TableColumn fx:id="colNomDci"            text="Nom DCI"           prefWidth="120"/>
                <TableColumn fx:id="colCodeBarre"         text="Code Barre"        prefWidth="100"/>
                <TableColumn fx:id="colDosage"            text="Dosage"            prefWidth="80"/>
                <TableColumn fx:id="colUniteDosage"       text="Unité"             prefWidth="70"/>
                <TableColumn fx:id="colDescription"       text="Description"       prefWidth="150"/>
                <TableColumn fx:id="colEstActif"          text="Actif"             prefWidth="60"/>
            </columns>
        </TableView>

    </children>
</AnchorPane>