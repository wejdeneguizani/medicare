<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medical.controllers.FormeController"
            stylesheets="@style.css">

    <children>
        <VBox spacing="15" layoutX="20" layoutY="20" prefWidth="910">

            <!-- HEADER -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color: #fce4ec;
                   -fx-padding: 15px;
                   -fx-background-radius: 12px;">
                <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="@logo.png"/>
                    </image>
                </ImageView>
                <VBox spacing="4">
                    <Label text="Medicare+"
                           style="-fx-font-size: 28px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #e91e8c;"/>
                    <Label text="Votre santé, notre priorité"
                           style="-fx-font-size: 12px;
                        -fx-text-fill: #f48fb1;
                        -fx-font-style: italic;"/>
                </VBox>
            </HBox>

            <!-- NAVIGATION -->
            <HBox spacing="10" alignment="CENTER"
                  style="-fx-background-color: #f8bbd0;
             -fx-padding: 10px;
             -fx-background-radius: 10px;">
                <Button text="💊 Médicaments"
                        onAction="#allerMedicaments"
                        style="-fx-background-color: #f48fb1;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8px;
                   -fx-padding: 8px 20px;"/>
                <Button text="📋 Catégories"
                        onAction="#allerCategories"
                        style="-fx-background-color: #f48fb1;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8px;
                   -fx-padding: 8px 20px;"/>
                <Button text="🏭 Fabricants"
                        onAction="#allerFabricants"
                        style="-fx-background-color: #f48fb1;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8px;
                   -fx-padding: 8px 20px;"/>
                <Button text="💉 Formes"
                        onAction="#allerFormes"
                        style="-fx-background-color: #e91e8c;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8px;
                   -fx-padding: 8px 20px;"/>
                <Button text="📦 Stock"
                        onAction="#allerStock"
                        style="-fx-background-color: #f48fb1;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8px;
                   -fx-padding: 8px 20px;"/>
            </HBox>

            <!-- TITRE -->
            <Label text="Gestion des Formes Pharmaceutiques" styleClass="titre"/>

            <!-- FORMULAIRE -->
            <HBox spacing="10">
                <Label text="Libellé :" style="-fx-pref-width: 180"/>
                <TextField fx:id="tfLibelle" promptText="ex: Comprimé, Gélule..." prefWidth="200"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Voie d'administration :" style="-fx-pref-width: 180"/>
                <TextField fx:id="tfVoieAdministration" promptText="ex: orale, injectable..." prefWidth="200"/>
            </HBox>

            <!-- BOUTONS -->
            <HBox spacing="10">
                <Button text="➕ Ajouter" onAction="#ajouterForme"/>
                <Button text="🗑 Supprimer" onAction="#supprimerForme"
                        styleClass="button-supprimer"/>
            </HBox>

            <!-- MESSAGE -->
            <Label fx:id="lbMessage"/>

            <!-- TABLE -->
            <TableView fx:id="tableView" prefHeight="320" prefWidth="910">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colLibelle" text="Libellé" prefWidth="300"/>
                    <TableColumn fx:id="colVoie" text="Voie d'administration" prefWidth="300"/>
                </columns>
            </TableView>

        </VBox>
    </children>
</AnchorPane>
