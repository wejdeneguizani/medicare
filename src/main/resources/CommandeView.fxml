<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<AnchorPane prefHeight="750.0" prefWidth="1060.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medical.controllers.CommandeController"
            stylesheets="@style.css">
    <children>
        <ScrollPane fitToWidth="true"
                    AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                    style="-fx-background-color:transparent;-fx-background:transparent;">
            <content>
                <VBox spacing="11" style="-fx-padding:18;">

                    <!-- HEADER -->
                    <HBox spacing="14" alignment="CENTER_LEFT"
                          style="-fx-background-color:#fce4ec;-fx-padding:12;-fx-background-radius:12;">
                        <ImageView fitWidth="68" fitHeight="68" preserveRatio="true">
                            <image><Image url="@logo.png"/></image>
                        </ImageView>
                        <VBox spacing="3">
                            <Label text="Medicare+" style="-fx-font-size:26px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>
                            <Label text="Votre santé, notre priorité" style="-fx-font-size:11px;-fx-text-fill:#f48fb1;-fx-font-style:italic;"/>
                        </VBox>
                    </HBox>

                    <!-- NAV -->
                    <HBox spacing="6" alignment="CENTER"
                          style="-fx-background-color:#f9c4d8;-fx-padding:8;-fx-background-radius:10;">
                        <Button text="Médicaments" onAction="#allerMedicaments" styleClass="nav-btn"/>
                        <Button text="Catégories"  onAction="#allerCategories"  styleClass="nav-btn"/>
                        <Button text="Fabricants"  onAction="#allerFabricants"  styleClass="nav-btn"/>
                        <Button text="Formes"      onAction="#allerFormes"      styleClass="nav-btn"/>
                        <Button text="Stock"       onAction="#allerStock"       styleClass="nav-btn"/>
                        <Button text="Alertes"     onAction="#allerAlertes"     styleClass="nav-btn"/>
                        <Button text="Chatbot"     onAction="#allerChatbot"     styleClass="nav-btn"/>
                        <Button text="🛒 Commande" onAction="#allerCommande"
                                style="-fx-background-color:#f48fb1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:7 14;"/>
                        <Button text="💳 Paiement" onAction="#allerPaiement" styleClass="nav-btn"/>
                    </HBox>

                    <!-- TITRE -->
                    <Label text="🛒 Nouvelle Commande" styleClass="titre"/>

                    <!-- ÉTAPE 1 -->
                    <VBox spacing="8" style="-fx-background-color:#fff8fd;-fx-padding:14;-fx-background-radius:10;-fx-border-color:#f9c4d8;-fx-border-radius:10;">
                        <Label text="Étape 1 — Type de commande" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ToggleButton fx:id="tgClient" text="🛒 Vente client" onAction="#basculerVersClient" selected="true"
                                          style="-fx-background-color:#1565c0;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:8 18;"/>
                            <ToggleButton fx:id="tgReappro" text="📦 Réapprovisionnement" onAction="#basculerVersReappro"
                                          style="-fx-background-color:#e0e0e0;-fx-text-fill:#333;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:8 18;"/>
                            <Label fx:id="lbTypeInfo" text="🛒 Vente au client — le stock sera diminué"
                                   style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#1565c0;"/>
                        </HBox>
                    </VBox>

                    <!-- ÉTAPE 2 -->
                    <VBox spacing="9" style="-fx-background-color:#fff8fd;-fx-padding:14;-fx-background-radius:10;-fx-border-color:#f9c4d8;-fx-border-radius:10;">
                        <Label text="Étape 2 — Rechercher un médicament" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="🔎 Texte :" style="-fx-pref-width:75;-fx-font-weight:bold;"/>
                            <TextField fx:id="tfRecherche" promptText="Tapez le nom du médicament..." prefWidth="340" onAction="#rechercherParTexte"/>
                            <Button text="Rechercher" onAction="#rechercherParTexte"
                                    style="-fx-background-color:#e91e8c;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:7 16;"/>
                            <Button text="Tout afficher" onAction="#afficherTousStocks"
                                    style="-fx-background-color:#9c27b0;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:7 14;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="📋 Liste :" style="-fx-pref-width:75;-fx-font-weight:bold;"/>
                            <ComboBox fx:id="cbListeMedicaments" promptText="— Sélectionner dans la liste —" prefWidth="480"/>
                        </HBox>
                        <TableView fx:id="tableStock" prefHeight="155" prefWidth="1020">
                            <columns>
                                <TableColumn fx:id="colStockId"   text="ID"         prefWidth="55"/>
                                <TableColumn fx:id="colStockNom"  text="Médicament" prefWidth="280"/>
                                <TableColumn fx:id="colStockQte"  text="Dispo"      prefWidth="80"/>
                                <TableColumn fx:id="colStockPrix" text="Prix (DT)"  prefWidth="100"/>
                                <TableColumn fx:id="colStockLot"  text="N° Lot"     prefWidth="120"/>
                            </columns>
                            <placeholder><Label text="Recherchez ou sélectionnez un médicament"/></placeholder>
                        </TableView>
                    </VBox>

                    <!-- ÉTAPE 3 -->
                    <VBox fx:id="panneauFormulaire" spacing="10"
                          style="-fx-background-color:#fff8fd;-fx-padding:14;-fx-background-radius:10;-fx-border-color:#f9c4d8;-fx-border-radius:10;">
                        <Label text="Étape 3 — Informations de la commande" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>

                        <HBox spacing="22" alignment="CENTER_LEFT"
                              style="-fx-background-color:#fce4ec;-fx-padding:9;-fx-background-radius:8;">
                            <Label fx:id="lbMedicamentChoisi" style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#880e4f;"/>
                            <Label fx:id="lbStockDispo" style="-fx-font-size:12px;-fx-font-weight:bold;"/>
                            <Label fx:id="lbPrixInfo" style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#1565c0;"/>
                        </HBox>

                        <HBox spacing="30">
                            <VBox spacing="9">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label fx:id="lbNomLabel" text="Nom du client :" style="-fx-pref-width:155;-fx-font-weight:bold;"/>
                                    <TextField fx:id="tfNom" promptText="Nom complet" prefWidth="220"/>
                                </HBox>
                                <HBox fx:id="rowEmail" spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Email :" style="-fx-pref-width:155;-fx-font-weight:bold;"/>
                                    <TextField fx:id="tfEmail" promptText="exemple@gmail.com" prefWidth="220"/>
                                </HBox>
                                <HBox fx:id="rowTel" spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Téléphone :" style="-fx-pref-width:155;-fx-font-weight:bold;"/>
                                    <TextField fx:id="tfTelephone" promptText="(facultatif)" prefWidth="220"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="9">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Quantité :" style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                                    <TextField fx:id="tfQuantite" promptText="ex: 3" prefWidth="120"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label fx:id="lbModeLabel" text="Mode de paiement :" style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                                    <ComboBox fx:id="cbMode" prefWidth="190" onAction="#onModeChanged"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Montant total :" style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                                    <Label fx:id="lbMontant" text="—" style="-fx-font-size:17px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- CHAMPS CARTE BANCAIRE -->
                        <VBox fx:id="panneauCarte" spacing="10"
                              style="-fx-background-color:#e3f2fd;-fx-padding:14;-fx-background-radius:10;-fx-border-color:#1565c0;-fx-border-width:1.5;-fx-border-radius:10;">
                            <Label text="💳 Informations de carte bancaire"
                                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1565c0;"/>
                            <HBox spacing="30">
                                <VBox spacing="8">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Numéro de carte :" style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                                        <TextField fx:id="tfNumeroCarte" promptText="XXXX XXXX XXXX XXXX" prefWidth="220"
                                                   style="-fx-font-family:monospace;-fx-font-size:14px;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Titulaire :" style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                                        <TextField fx:id="tfTitulaire" promptText="NOM PRÉNOM" prefWidth="220"/>
                                    </HBox>
                                </VBox>
                                <VBox spacing="8">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Date d'expiration :" style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                                        <TextField fx:id="tfExpiration" promptText="MM/AA" prefWidth="100"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="CVV :" style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                                        <PasswordField fx:id="tfCvv" promptText="•••" prefWidth="80"/>
                                        <Label text="(3 chiffres au dos)" style="-fx-font-size:11px;-fx-text-fill:#666;"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                            <Label text="🔒 Paiement sécurisé — vos données sont protégées"
                                   style="-fx-font-size:11px;-fx-text-fill:#1565c0;-fx-font-style:italic;"/>
                        </VBox>

                        <Button text="✅ Confirmer la commande" onAction="#confirmerCommande"
                                style="-fx-background-color:#e91e8c;-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:14px;-fx-background-radius:10;-fx-padding:10 28;"/>
                    </VBox>

                    <Label fx:id="lbMessage" style="-fx-font-size:13px;"/>

                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
