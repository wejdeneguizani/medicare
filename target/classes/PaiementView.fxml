<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<AnchorPane prefHeight="750.0" prefWidth="1060.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medical.controllers.PaiementController"
            stylesheets="@style.css">
    <children>
        <VBox spacing="12" layoutX="18" layoutY="12" prefWidth="1024">

            <!-- HEADER -->
            <HBox spacing="14" alignment="CENTER_LEFT"
                  style="-fx-background-color:#fce4ec;-fx-padding:12;-fx-background-radius:12;">
                <ImageView fitWidth="68" fitHeight="68" preserveRatio="true">
                    <image><Image url="@logo.png"/></image>
                </ImageView>
                <VBox spacing="3">
                    <Label text="Medicare+"
                           style="-fx-font-size:26px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>
                    <Label text="Votre santé, notre priorité"
                           style="-fx-font-size:11px;-fx-text-fill:#f48fb1;-fx-font-style:italic;"/>
                </VBox>
            </HBox>

            <!-- NAV -->
            <HBox spacing="6" alignment="CENTER"
                  style="-fx-background-color:#f9c4d8;-fx-padding:8;-fx-background-radius:10;">
                <Button text="Médicaments" onAction="#allerMedicaments" styleClass="nav-btn"/>
                <Button text="Catégories"  onAction="#allerCategories"  styleClass="nav-btn"/>
                <Button text="Fabricants"  onAction="#allerFabricants"  styleClass="nav-btn"/>
                <Button text="Formes"      onAction="#allerFormes"      styleClass="nav-btn"/>
                <Button text="Stock"       onAction="#allerStock"       styleClass="nav-btn"/>
                <Button text="Alertes"     onAction="#allerAlertes"     styleClass="nav-btn"/>
                <Button text="Chatbot"     onAction="#allerChatbot"     styleClass="nav-btn"/>
                <Button text="🛒 Commande" onAction="#allerCommande"    styleClass="nav-btn"/>
                <Button text="💳 Paiement" onAction="#allerPaiement"
                        style="-fx-background-color:#e91e8c;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:7 14;"/>
            </HBox>

            <!-- TITRE -->
            <Label text="💳 Paiement &amp; Reçu" styleClass="titre"/>

            <!-- RÉCAPITULATIF COMMANDE -->
            <VBox spacing="10"
                  style="-fx-background-color:#fff8fd;-fx-padding:18;-fx-background-radius:12;-fx-border-color:#f9c4d8;-fx-border-radius:12;">
                <Label text="Récapitulatif de la commande"
                       style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>

                <HBox spacing="30">
                    <VBox spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="N° Commande :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbNumero"
                                   style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#1565c0;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Type :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbType"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Client / Fournisseur :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbNom"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Email :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbEmail"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Médicament :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbMedicament"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Quantité :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbQuantite"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Prix unitaire :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbPrix"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Mode de paiement :"
                                   style="-fx-pref-width:160;-fx-font-weight:bold;"/>
                            <Label fx:id="lbMode"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- MONTANT TOTAL -->
                <HBox alignment="CENTER_RIGHT" style="-fx-padding:10 0 0 0;">
                    <Label text="MONTANT TOTAL : "
                           style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#333;"/>
                    <Label fx:id="lbMontantTotal"
                           style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>
                </HBox>
            </VBox>

            <!-- ACTIONS -->
            <VBox spacing="12"
                  style="-fx-background-color:#fff8fd;-fx-padding:18;-fx-background-radius:12;-fx-border-color:#f9c4d8;-fx-border-radius:12;">
                <Label text="Actions"
                       style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#e91e8c;"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Button text="📄 Générer PDF" onAction="#genererPdf"
                            style="-fx-background-color:#1565c0;-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13px;-fx-background-radius:10;-fx-padding:10 24;"/>
                    <Button fx:id="btnImprimer" text="🖨 Imprimer" onAction="#imprimerRecu"
                            style="-fx-background-color:#9c27b0;-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13px;-fx-background-radius:10;-fx-padding:10 24;"
                            disable="true"/>
                    <Button fx:id="btnEmail" text="📧 Envoyer par Email" onAction="#envoyerEmail"
                            style="-fx-background-color:#e91e8c;-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13px;-fx-background-radius:10;-fx-padding:10 24;"
                            disable="true"/>
                </HBox>
                <Label fx:id="lbMessage"
                       style="-fx-font-size:13px;-fx-font-weight:bold;"/>
            </VBox>

        </VBox>
    </children>
</AnchorPane>
